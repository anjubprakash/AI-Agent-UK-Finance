# Server Environment
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/uk_finance_compliance
JWT_SECRET=uk_finance_rules_checking_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# Groq LLM Configuration
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Specify any model supported by Groq (e.g. openai/gpt-oss-120b, llama-3.3-70b-versatile, llama-3.1-8b-instant, etc.)
GROQ_MODEL=openai/gpt-oss-120b

# Qdrant Vector Database Configuration (Cloud URL or http://localhost:6333)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=uk_financial_rules

# Embedding Model Configuration
# 'all-minilm' runs locally & 100% offline via HuggingFace Transformers ONNX (384-dim, free, no API key needed)
EMBEDDING_PROVIDER=all-minilm
OPENAI_API_KEY=
HF_TOKEN=
